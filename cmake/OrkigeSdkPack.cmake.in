# OrkigeSdkPack.cmake - the SDK pack's own description of itself.
#
# ONLY an installed pack carries this file, as OrkigeSdkPack.cmake beside its
# copy of OrkigeGameModule.cmake (cmake/OrkigeSdk.cmake puts it there). That is
# deliberate and load-bearing: its presence next to the game-module helper is
# the MARKER that puts the helper into pack mode, so the engine source tree must
# NOT carry a file by that name - which is why the source form is a template the
# install step realizes.
#
# It is also the ONE place the pack layout is written down: the pack's own
# install-time stamp recording and a consumer's recomputation both read the ABI
# surface from here, so there is a single definition of what a pack IS.
#
# Everything is derived from this file's own location, which is what makes a
# pack relocatable - unpack it anywhere and it still answers correctly.
#
# Consumers of the pack do not include this directly; they include
# OrkigeGameModule.cmake, exactly as a build-tree consumer does.

include_guard(GLOBAL)

get_filename_component(ORKIGE_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

# where find_package(Orkige ... CONFIG PATHS <dir>) finds OrkigeConfig.cmake
set(ORKIGE_SDK_PACKAGE_DIR "${ORKIGE_SDK_ROOT}/cmake")
# the dependency closure the engine archives were built against
set(ORKIGE_SDK_VCPKG_PREFIX "${ORKIGE_SDK_ROOT}/vcpkg")
# the engine's runtime media (fonts, the shared water plane)
set(ORKIGE_SDK_MEDIA_DIR "${ORKIGE_SDK_ROOT}/media")

# THE PACK'S ABI SURFACE - the same role the engine's compiled sources play for
# a build tree. A pack has no .cpp files, but it has what actually decides
# object layout for a consumer: the installed headers, plus the cmake files that
# define how a module compiles and links against them. cmake/OrkigeSdk.cmake
# records the stamp of exactly this surface at install time and the game-module
# helper recomputes it here, so an edited installed header is a hard configure
# error instead of a skewed layout at run time. Paths are relative to the pack
# root (orkige_compute_abi_stamp resolves them against the root it is given).
set(ORKIGE_SDK_ABI_SOURCE_DIRS include)
set(ORKIGE_SDK_ABI_EXTRA_FILES
    cmake/OrkigeGameModule.cmake
    cmake/OrkigeAbiStamp.cmake
    cmake/OrkigeWriteVersion.cmake
    cmake/OrkigeSdkPack.cmake
    cmake/OrkigeConfig.cmake)
