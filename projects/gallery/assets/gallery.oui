# The UI gallery: every runtime widget kind on one tabbed screen, authored
# declaratively. A tab bar pairs five tab toggles with five content panels; each
# panel is a layout group so the rows arrange themselves at any window size.
# scripts/gallery.lua only wires behaviour (list population, the slider ->
# progress mirror, modal/dialog/toast triggers) - the LAYOUT is here.
#
# Authoring rules this file follows (they are the resolver's rules):
#   * `design` is a PORTRAIT PHONE reference, so the geometry scale a device
#     resolves to matches the glyph scale - authored sizes and text then share
#     one unit and text always fits the box it was authored for.
#   * a child of a layout GROUP is arranged by the group: its `size` gives the
#     row height (the group hands it the column width), and its own anchors /
#     offsets do not apply. Only a child of a plain container uses those.
#   * a label longer than its column carries `wrap = true` (+ `fit` preferred)
#     instead of `fit = preferred` alone, which would measure PAST the column
#     and run off the screen.
#
# The screen is authored PORTRAIT, for a phone: in a short landscape window the
# tab column keeps its order and width but runs past the bottom fold.
#
# Sections are grouped by tab: Text, Controls, Lists, Overlays, Styles.
#
# The [Style NAME] sections at the bottom are property BUNDLES: a widget
# names one with `style = NAME` and the bundle SEEDS its keys, which the
# widget's own keys then override (declaration-order precedence). They are
# not widgets and have no rect.

[Layout]
atlas = gui_default
design = 400 860 0.5
root = SafeArea

# --- the frame: a title block and the tab block above the panel area ---

[Panel frame]
sprite = panel
nineSlice = true
z = 1
anchor = stretchall
offsets = 8 8 -8 -8
color = 0.12 0.13 0.17 0.92

# the heading wraps, so it reads in full on a narrow phone (two lines) as well
# as on a wider window (one line); the strip is tall enough for two and the
# caption centres in it either way
[Label title]
font = 24
text = @gallery.title
z = 2
parent = frame
anchor = stretchtop
offsets = 8 8 -8 84
wrap = true
# the screen introduces itself: an `enter` transition plays once, as this
# layout is built, and settles at full opacity (a widget that declares none is
# built exactly as before)
enter = fade 0.35 quadOut

# the tabs: a two-column grid block, because descriptive captions do not fit
# one row at phone width. The grid group gives every tab the same cell.
[Panel tabblock]
sprite = none
color = 0 0 0 0
z = 2
parent = frame
anchor = stretchtop
offsets = 8 92 -8 200
group = grid
gridConstraint = columns 2
cellSize = 180 32
spacing = 6 6

[CheckBox tabText]
sprite = checkbox
nineSlice = true
font = 9
text = @gallery.tab.text
z = 2
parent = tabblock

[CheckBox tabControls]
sprite = checkbox
nineSlice = true
font = 9
text = @gallery.tab.controls
z = 2
parent = tabblock

[CheckBox tabLists]
sprite = checkbox
nineSlice = true
font = 9
text = @gallery.tab.lists
z = 2
parent = tabblock

[CheckBox tabOverlays]
sprite = checkbox
nineSlice = true
font = 9
text = @gallery.tab.overlays
z = 2
parent = tabblock

[CheckBox tabStyles]
sprite = checkbox
nineSlice = true
font = 9
text = @gallery.tab.styles
z = 2
parent = tabblock

[TabBar tabs]
tabs = tabText tabControls tabLists tabOverlays tabStyles
panels = panelText panelControls panelLists panelOverlays panelStyles
selected = 0

# --- tab 1: text - plain, wrapped, localised, multi-line entry ---

[Panel panelText]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 8 208 -8 -8
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

[Label plainLabel]
font = 9
text = A plain label.
textAlignment = left
z = 3
parent = panelText
fit = none preferred

[Label wrappedLabel]
font = 9
text = A wrapped label breaks to the width the layout gives it, so a long paragraph of body copy flows into as many lines as the column needs instead of running off the edge of the screen.
textAlignment = left
z = 3
parent = panelText
fit = none preferred
wrap = true

[Label localisedLabel]
font = 9
text = @gallery.localised
textAlignment = left
z = 3
parent = panelText
fit = none preferred
wrap = true

[Label notesLabel]
font = 9
text = Multi-line entry (Return inserts a line break):
textAlignment = left
z = 3
parent = panelText
fit = none preferred
wrap = true

[TextEntry notes]
sprite = select_menu_field
nineSlice = true
font = 9
text = type a note
size = 300 96
z = 3
parent = panelText
multiline = true
maxLength = 400

# --- tab 2: controls - buttons, toggles, slider, progress, menus, field ---

[Panel panelControls]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 8 208 -8 -8
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

[Panel buttonRow]
sprite = none
color = 0 0 0 0
z = 3
parent = panelControls
group = horizontal
spacing = 8
childExpand = true

[Button plainButton]
sprite = button
font = 9
text = Plain
size = 110 36
z = 3
parent = buttonRow

[Button sliceButton]
sprite = button
nineSlice = true
font = 9
text = Nine-slice
size = 150 36
z = 3
parent = buttonRow

# a REAL checkbox: the plate carries the row, the check symbol keeps its own
# size at the trailing edge and the caption reads beside it
[CheckBox optionBox]
sprite = select_menu_field
checkbox = true
nineSlice = true
font = 9
text = A checkbox
size = 300 32
z = 3
parent = panelControls

# a segmented control: three PLATE-skin toggles in one single-selection group
# (no check symbol - the plate's on state is the selection)
[Panel toggleRow]
sprite = none
color = 0 0 0 0
z = 3
parent = panelControls
group = horizontal
spacing = 8
childExpand = true

[CheckBox toggleEasy]
sprite = checkbox
nineSlice = true
font = 9
text = Easy
size = 95 32
z = 3
parent = toggleRow

[CheckBox toggleNormal]
sprite = checkbox
nineSlice = true
font = 9
text = Normal
size = 95 32
z = 3
parent = toggleRow

[CheckBox toggleHard]
sprite = checkbox
nineSlice = true
font = 9
text = Hard
size = 95 32
z = 3
parent = toggleRow

[ToggleGroup difficulty]
members = toggleEasy toggleNormal toggleHard
selected = 1

# the same checkbox worn with a switch sprite pair
[CheckBox toggleSwitch]
sprite = select_menu_field
checkbox = true
nineSlice = true
font = 9
text = A toggle switch
size = 300 32
z = 3
parent = panelControls

[Slider volume]
sprite = select_menu_field
nineSlice = true
font = 9
text = Volume
size = 300 32
z = 3
parent = panelControls
items = 0 | 25 | 50 | 75 | 100

[ProgressBar loading]
sprite = progressbar
nineSlice = true
font = 9
text = Loading
size = 300 24
z = 3
parent = panelControls

[SelectMenu quality]
sprite = select_menu_field
nineSlice = true
font = 9
text = Quality
size = 300 32
z = 3
parent = panelControls
items = Low | Medium | High

[DropDown resolution]
sprite = button
nineSlice = true
font = 9
text = Resolution
size = 300 32
z = 3
parent = panelControls
items = 1280 x 720 | 1920 x 1080 | 2560 x 1440

[TextEntry playerName]
sprite = select_menu_field
nineSlice = true
font = 9
text = your name
size = 300 32
z = 3
parent = panelControls

# --- tab 3: lists - a scroll view of decor panels and a virtualized list ---

[Panel panelLists]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 8 208 -8 -8
group = vertical
padding = 8 8 8 8
spacing = 12
childExpand = true

# each scroll region owns its OWN draw layer (z): the clip is a per-layer
# scissor, so the list below must not share this one
[ScrollView decorScroll]
size = 300 150
z = 7
parent = panelLists

[Panel decorColumn]
sprite = none
color = 0 0 0 0
z = 7
parent = decorScroll
anchor = stretchtop
offsets = 0 0 0 0
group = vertical
padding = 4 4 4 4
spacing = 8
childExpand = true
fit = none preferred

[Label decorHeading]
font = 9
text = Decor draw modes
textAlignment = left
z = 7
parent = decorColumn
fit = none preferred
wrap = true

[Panel decorStretch]
sprite = panel
size = 140 40
z = 7
parent = decorColumn

[Panel decorSlice]
sprite = panel
nineSlice = true
size = 140 40
z = 7
parent = decorColumn

[Panel decorTiled]
sprite = panel
tiled = true
size = 140 40
z = 7
parent = decorColumn

[Label scrollNote]
font = 9
text = Drag or wheel this column to scroll it; the clip is the layer scissor.
textAlignment = left
z = 7
parent = decorColumn
fit = none preferred
wrap = true

[Label listHeading]
font = 9
text = A 1000-row list, virtualized
textAlignment = left
z = 3
parent = panelLists
fit = none preferred
wrap = true

[ListView bigList]
size = 300 300
z = 8
parent = panelLists
itemHeight = 24
virtualized = true

# --- tab 4: overlays - modal, confirm dialog and toast triggers ---

[Panel panelOverlays]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 8 208 -8 -8
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true
# two channels in one spec: the panel fades AND drops in from 24px above every
# time its tab reveals it, each channel with its own timing/curve. Leaving the
# tab snaps it hidden again (no `exit` clause authored).
enter = fade 0.25 quadOut | slide 0 -24 0.3 backOut

[Label overlayNote]
font = 9
text = Overlays raise their own modal layers above this screen; the scrim consumes input underneath.
textAlignment = left
z = 3
parent = panelOverlays
fit = none preferred
wrap = true

[Button showModalButton]
sprite = button
nineSlice = true
font = 9
text = Show a modal panel
size = 300 36
z = 3
parent = panelOverlays
pressFeedback = true

[Button showConfirmButton]
sprite = button
nineSlice = true
font = 9
text = Ask a confirm dialog
size = 300 36
z = 3
parent = panelOverlays
pressFeedback = true

[Button showToastButton]
sprite = button
nineSlice = true
font = 9
text = Raise a toast
size = 300 36
z = 3
parent = panelOverlays
pressFeedback = true

[Label overlayResult]
font = 9
text = (no dialog answered yet)
textAlignment = left
z = 3
parent = panelOverlays
fit = none preferred
wrap = true

# --- tab 5: styles - the second font, coloured + scaled text, named styles ---

[Panel panelStyles]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 8 208 -8 -8
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

# `font = heading` names the ROLE the atlas font declares (its `[Font.N] name`
# key), not the index - a name survives the atlas gaining a size. The colour and
# the size come from the style, so this section carries only its text.
[Label styleHeading]
style = heroStyle
text = Named styles
textAlignment = left
size = 300 40
z = 3
parent = panelStyles

[Label styleBody]
style = quietStyle
text = A style is a bundle of ordinary widget keys. A widget that names one is seeded with them, and any key it spells out itself overrides the bundle.
textAlignment = left
z = 3
parent = panelStyles
fit = none preferred
wrap = true

# two buttons wearing the SAME style; the second overrides just its ink, which
# is the precedence rule made visible (its font and scale still come from the
# style, only the colour is local)
[Panel styleButtonRow]
sprite = none
color = 0 0 0 0
z = 3
parent = panelStyles
group = horizontal
spacing = 8
childExpand = true

[Button styleButtonA]
style = heroStyle
sprite = button
nineSlice = true
text = Style
size = 140 36
z = 3
parent = styleButtonRow
# press juice: the face snaps smaller under the finger and springs back
pressFeedback = true

[Button styleButtonB]
style = heroStyle
sprite = button
nineSlice = true
text = Local
textColor = 0.35 1 0.65 1
size = 140 36
z = 3
parent = styleButtonRow

# explicit keys, no style: the body font drawn at twice its baked size. A WHOLE
# multiple resamples the baked glyph texels exactly, so it stays crisp.
[Label scaledLabel]
font = body
text = Twice the size
textColor = 0.45 0.78 1 1
textScale = 2
textAlignment = left
size = 300 40
z = 3
parent = panelStyles

# --- inline RICH TEXT: several styled runs inside ONE caption ---
# `markup = true` reads `[c=RRGGBB]` and `[f=NAME]` spans plus `[sprite=NAME]`
# icons out of the text ( `[[` writes a literal bracket ). The tags are NOT
# glyphs, so this label measures exactly like the tag-free control below it.
[Label richText]
markup = true
font = body
text = [c=FFCC33]Rich[/c] text runs
textAlignment = left
size = 300 30
z = 3
parent = panelStyles

# the same visible sentence, no tags, markup off: the control that makes the
# "tags cost no width" claim checkable
[Label richPlain]
font = body
text = Rich text runs
textAlignment = left
size = 300 30
z = 3
parent = panelStyles

# a heading run and an inline icon inside body copy: the taller run raises the
# line height for the whole wrapped block, and the icon is one atomic cell that
# moves whole rather than splitting at a line end
[Label richIcon]
markup = true
font = body
text = A [f=heading]heading run[/f] and an icon [sprite=checkbox_on] flow across the wrap with the [c=6FD3FF]body copy[/c].
textAlignment = left
z = 3
parent = panelStyles
fit = none preferred
wrap = true

# a toggle wears a style too - the caption of any text-bearing kind does
[CheckBox styleToggle]
style = quietStyle
sprite = select_menu_field
checkbox = true
nineSlice = true
text = A styled toggle
size = 300 32
z = 3
parent = panelStyles

# --- the named styles (property bundles, not widgets) ---

[Style heroStyle]
font = heading
textColor = 1 0.82 0.35 1
textScale = 1

[Style quietStyle]
font = body
textColor = 0.62 0.66 0.74 1
textScale = 1
