# The UI gallery: every runtime widget kind on one tabbed screen, authored
# declaratively. A tab bar pairs four checkbox tabs with four content panels;
# each panel is a layout group so the rows arrange themselves at any window
# size. scripts/gallery.lua only wires behaviour (list population, the
# slider -> progress mirror, modal/dialog/toast triggers) - the LAYOUT is here.
#
# Sections are grouped by tab: Text, Controls, Lists, Overlays.

[Layout]
atlas = gui_default
design = 960 640 0.5
root = SafeArea

# --- the frame: a title strip and the tab row above the panel area ---

[Panel frame]
sprite = panel
nineSlice = true
z = 1
anchor = stretchall
offsets = 12 12 -12 -12
color = 0.12 0.13 0.17 0.92

[Label title]
font = 24
text = @gallery.title
z = 2
parent = frame
anchor = stretchtop
offsets = 16 12 -16 46

[Panel tabrow]
sprite = none
color = 0 0 0 0
z = 2
parent = frame
anchor = stretchtop
offsets = 16 52 -16 88
group = horizontal
spacing = 8
childExpand = true

[CheckBox tabText]
sprite = checkbox
size = 180 32
font = 9
text = @gallery.tab.text
z = 2
parent = tabrow

[CheckBox tabControls]
sprite = checkbox
size = 180 32
font = 9
text = @gallery.tab.controls
z = 2
parent = tabrow

[CheckBox tabLists]
sprite = checkbox
size = 180 32
font = 9
text = @gallery.tab.lists
z = 2
parent = tabrow

[CheckBox tabOverlays]
sprite = checkbox
size = 180 32
font = 9
text = @gallery.tab.overlays
z = 2
parent = tabrow

[TabBar tabs]
tabs = tabText tabControls tabLists tabOverlays
panels = panelText panelControls panelLists panelOverlays
selected = 0

# --- tab 1: text - plain, wrapped, localised, multi-line entry ---

[Panel panelText]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 16 96 -16 -16
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

[Label plainLabel]
font = 9
text = A plain single-line label measured to its text.
z = 3
parent = panelText
fit = preferred preferred

[Label wrappedLabel]
font = 9
text = A wrapped label breaks to the width the layout gives it, so a long paragraph of body copy flows into as many lines as the column needs instead of running off the edge of the screen.
z = 3
parent = panelText
anchor = stretchtop
offsets = 0 0 0 0
fit = none preferred
wrap = true

[Label localisedLabel]
font = 9
text = @gallery.localised
z = 3
parent = panelText
fit = preferred preferred

[Label notesLabel]
font = 9
text = Multi-line text entry (Return inserts a line break):
z = 3
parent = panelText
fit = preferred preferred

[TextEntry notes]
sprite = select_menu_field
font = 9
text = type a note
z = 3
parent = panelText
anchor = stretchtop
offsets = 0 0 0 96
multiline = true
maxLength = 400

# --- tab 2: controls - buttons, toggles, slider, progress, menus, field ---

[Panel panelControls]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 16 96 -16 -16
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

[Panel buttonRow]
sprite = none
color = 0 0 0 0
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 40
group = horizontal
spacing = 8
childExpand = true

[Button plainButton]
sprite = button
font = 9
text = Plain
z = 3
parent = buttonRow

[Button sliceButton]
sprite = button
nineSlice = true
font = 9
text = Nine-slice
z = 3
parent = buttonRow

[CheckBox optionBox]
sprite = checkbox
font = 9
text = A checkbox
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32

[Panel toggleRow]
sprite = none
color = 0 0 0 0
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 40
group = horizontal
spacing = 8
childExpand = true

[CheckBox toggleEasy]
sprite = checkbox
font = 9
text = Easy
z = 3
parent = toggleRow

[CheckBox toggleNormal]
sprite = checkbox
font = 9
text = Normal
z = 3
parent = toggleRow

[CheckBox toggleHard]
sprite = checkbox
font = 9
text = Hard
z = 3
parent = toggleRow

[ToggleGroup difficulty]
members = toggleEasy toggleNormal toggleHard
selected = 1

[CheckBox toggleSwitch]
sprite = checkbox
font = 9
text = A toggle switch is the same checkbox worn with a switch sprite pair
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32

[Slider volume]
sprite = select_menu_field
font = 9
text = Volume
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32

[ProgressBar loading]
sprite = progressbar
font = 9
text = Loading
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 24

[SelectMenu quality]
sprite = select_menu_field
font = 9
text = Quality
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32

[DropDown resolution]
sprite = button
nineSlice = true
font = 9
text = Resolution
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32
items = 1280 x 720 | 1920 x 1080 | 2560 x 1440

[TextEntry playerName]
sprite = select_menu_field
font = 9
text = your name
z = 3
parent = panelControls
anchor = stretchtop
offsets = 0 0 0 32
maxLength = 24

# --- tab 3: lists - a scroll view of decor panels and a virtualized list ---

[Panel panelLists]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 16 96 -16 -16
group = horizontal
padding = 8 8 8 8
spacing = 12
childExpand = true

[ScrollView decorScroll]
z = 7
parent = panelLists

[Panel decorColumn]
sprite = none
color = 0 0 0 0
z = 7
parent = decorScroll
anchor = stretchtop
offsets = 0 0 0 0
group = vertical
padding = 4 4 4 4
spacing = 8
childExpand = true
fit = none preferred

[Label decorHeading]
font = 9
text = Decor draw modes
z = 7
parent = decorColumn
fit = none preferred

[Panel decorStretch]
sprite = panel
z = 7
parent = decorColumn
anchor = stretchtop
offsets = 0 0 0 56

[Panel decorSlice]
sprite = panel
nineSlice = true
z = 7
parent = decorColumn
anchor = stretchtop
offsets = 0 0 0 56

[Panel decorTiled]
sprite = panel
tiled = true
z = 7
parent = decorColumn
anchor = stretchtop
offsets = 0 0 0 56

[Label scrollNote]
font = 9
text = Drag or wheel this column to scroll it; the clip is the layer scissor.
z = 7
parent = decorColumn
anchor = stretchtop
offsets = 0 0 0 0
fit = none preferred
wrap = true

[ListView bigList]
z = 8
parent = panelLists
itemHeight = 24
virtualized = true

# --- tab 4: overlays - modal, confirm dialog and toast triggers ---

[Panel panelOverlays]
sprite = none
color = 0 0 0 0
z = 3
parent = frame
anchor = stretchall
offsets = 16 96 -16 -16
group = vertical
padding = 8 8 8 8
spacing = 10
childExpand = true

[Label overlayNote]
font = 9
text = Overlays raise their own modal layers above this screen; the scrim consumes input underneath.
z = 3
parent = panelOverlays
anchor = stretchtop
offsets = 0 0 0 0
fit = none preferred
wrap = true

[Button showModalButton]
sprite = button
nineSlice = true
font = 9
text = Show a modal panel
z = 3
parent = panelOverlays
anchor = stretchtop
offsets = 0 0 0 36

[Button showConfirmButton]
sprite = button
nineSlice = true
font = 9
text = Ask a confirm dialog
z = 3
parent = panelOverlays
anchor = stretchtop
offsets = 0 0 0 36

[Button showToastButton]
sprite = button
nineSlice = true
font = 9
text = Raise a toast
z = 3
parent = panelOverlays
anchor = stretchtop
offsets = 0 0 0 36

[Label overlayResult]
font = 9
text = (no dialog answered yet)
z = 3
parent = panelOverlays
fit = preferred preferred
