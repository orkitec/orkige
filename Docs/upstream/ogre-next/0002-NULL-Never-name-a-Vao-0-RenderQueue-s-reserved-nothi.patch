From d998266d3145b3545497e40db334816aa026b7b9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Steffen=20R=C3=B6mer?= <steffen.roemer@orkitec.com>
Date: Tue, 4 Aug 2026 10:54:18 +0300
Subject: [PATCH] [NULL] Never name a Vao 0 (RenderQueue's reserved "nothing
 bound")

NULLVaoManager named each new Vao after the size of the live-Vao set, so
the first Vao it ever handed out was named 0 - the value RenderQueue uses
for "no Vao bound yet" - and the first draw call tripped

    OGRE_ASSERT_MEDIUM( vao->getVaoName() != 0u && "Invalid Vao name! ..." )

in RenderQueue::renderGL3/renderES2, aborting every Debug build.

Deriving the name from a live count also reuses names: destroying one Vao
and creating another hands the new one a name a still-live Vao already
holds, and RenderQueue's lastVaoName check then skips the CbVao command
between two different Vaos.

Use a monotonic counter starting at 1, exactly like MetalVaoManager and
VulkanVaoManager (both `mVaoNames( 1 )`).
---
 RenderSystems/NULL/include/Vao/OgreNULLVaoManager.h | 4 ++++
 RenderSystems/NULL/src/Vao/OgreNULLVaoManager.cpp   | 4 ++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/RenderSystems/NULL/include/Vao/OgreNULLVaoManager.h b/RenderSystems/NULL/include/Vao/OgreNULLVaoManager.h
index eba1ef55a..cfe32a7f2 100644
--- a/RenderSystems/NULL/include/Vao/OgreNULLVaoManager.h
+++ b/RenderSystems/NULL/include/Vao/OgreNULLVaoManager.h
@@ -129,6 +129,10 @@ namespace Ogre
 
         VaoVec mVaos;
 
+        /// 0 is reserved by RenderQueue as "no Vao bound", so names start at 1.
+        /// Monotonic: a name is never reused, not even after the Vao is destroyed.
+        uint32 mVaoNames;
+
         VertexBufferPacked *mDrawId;
 
     protected:
diff --git a/RenderSystems/NULL/src/Vao/OgreNULLVaoManager.cpp b/RenderSystems/NULL/src/Vao/OgreNULLVaoManager.cpp
index a72a3f0aa..dd82a9aa3 100644
--- a/RenderSystems/NULL/src/Vao/OgreNULLVaoManager.cpp
+++ b/RenderSystems/NULL/src/Vao/OgreNULLVaoManager.cpp
@@ -45,7 +45,7 @@ THE SOFTWARE.
 
 namespace Ogre
 {
-    NULLVaoManager::NULLVaoManager() : VaoManager( 0 ), mDrawId( 0 )
+    NULLVaoManager::NULLVaoManager() : VaoManager( 0 ), mVaoNames( 1u ), mDrawId( 0 )
     {
         mConstBufferAlignment = 256;
         mTexBufferAlignment = 256;
@@ -290,7 +290,7 @@ namespace Ogre
         const VertexBufferPackedVec &vertexBuffers, IndexBufferPacked *indexBuffer,
         OperationType opType )
     {
-        uint32 idx = (uint32)mVertexArrayObjects.size();
+        uint32 idx = mVaoNames++;
 
         const uint32 bitsOpType = 3;
         const uint32 bitsVaoGl = 2;
